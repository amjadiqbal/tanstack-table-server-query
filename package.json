{
  "name": "@amjadiqbal/tanstack-table-server-query",
  "version": "0.1.1",
  "description": "Turn TanStack Table v9 state (sorting, column filters, global filter, pagination) into safe server-side queries for Drizzle, Prisma, Kysely and Supabase.",
  "license": "MIT",
  "author": "Amjad Iqbal (https://amjad.com.pk)",
  "homepage": "https://github.com/amjadiqbal/tanstack-table-server-query#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amjadiqbal/tanstack-table-server-query.git"
  },
  "bugs": "https://github.com/amjadiqbal/tanstack-table-server-query/issues",
  "keywords": [
    "tanstack",
    "tanstack-table",
    "react-table",
    "server-side",
    "pagination",
    "drizzle",
    "prisma",
    "kysely",
    "supabase",
    "postgrest",
    "data-table",
    "standard-schema"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "import": "./dist/prisma.js"
    },
    "./kysely": {
      "types": "./dist/kysely.d.ts",
      "import": "./dist/kysely.js"
    },
    "./supabase": {
      "types": "./dist/supabase.d.ts",
      "import": "./dist/supabase.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "ci": "bash scripts/ci-local.sh"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0",
    "kysely": ">=0.27.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  },
  "devDependencies": {
    "@amjadiqbal/tanstack-table-url-state": "^0.1.1",
    "@eslint/js": "^10.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/postgrest-js": "^2.118.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/table-core": "^9.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.13.0",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
